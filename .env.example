# --- Supabase Local / DEV ---
# URL de la API de Supabase local o DEV
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clave anónima pública de Supabase local o DEV
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Electronic Billing Service ---
# URL del servicio privado (No accesible desde internet directo)
BILLING_SERVICE_URL=http://localhost:5000
# Token interno o placeholder de autenticación para uso entre contenedores
BILLING_SERVICE_API_KEY=your_internal_api_key_here

# --- Entorno ---
NODE_ENV=development
