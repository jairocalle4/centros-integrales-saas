# --- Supabase Local / DEV ---
# URL de la API de Supabase local o DEV
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clave anónima pública de Supabase local o DEV
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Electronic Billing (llamado desde supabase/functions/electronic-billing) ---
# La emisión real ante el SRI (XML, firma XAdES-BES, SOAP) la hace una
# instancia dedicada del proyecto open-source open-api-facturacion-sri
# (NestJS), separada de la que usa el ERP en producción. El Edge Function
# hace login, sincroniza emisor/punto de emisión, sube el certificado y
# emite — nunca el navegador.
SRI_API_URL=https://<tu-instancia>.onrender.com
SRI_API_SERVICE_EMAIL=
SRI_API_SERVICE_PASSWORD=

# Microservicio propio (services/electronic-billing) — ya no firma ni habla
# con el SRI, solo genera el RIDE (PDF+QR) de un comprobante ya autorizado.
RIDE_SERVICE_URL=http://localhost:5223
# Token interno compartido entre la Edge Function y este microservicio.
# Mismo valor que RIDE_SERVICE_API_KEY en services/electronic-billing/.env.example.
RIDE_SERVICE_API_KEY=your_internal_api_key_here

# --- Entorno ---
NODE_ENV=development
